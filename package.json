{
	"engines": {
		"node": ">=20.10.0",
		"npm": ">=10.2.3"
	},
	"volta": {
		"node": "20.11.1"
	},
	"author": "inc2734",
	"license": "GPL-2.0+",
	"devDependencies": {
		"@wordpress/browserslist-config": "^6.35.0",
		"@wordpress/env": "^11.13.0",
		"@wordpress/icons": "^11.2.0",
		"@wordpress/scripts": "^31.0.0",
		"autoprefixer": "^10.4.22",
		"browser-sync": "^3.0.4",
		"classnames": "^2.5.1",
		"cssnano": "^7.1.2",
		"node-sass": "^9.0.0",
		"npm-run-all": "^4.1.5",
		"postcss": "^8.5.6",
		"postcss-cli": "^11.0.1",
		"rimraf": "^6.1.2"
	},
	"scripts": {
		"export:wp-content:themes": "npm run cli cp -- -r ../../themes .export/wp-content",
		"export:wp-content:uploads": "npm run cli cp -- -r ../../uploads .export/wp-content",
		"export:wp-content": "npm run cli rm -- -rf .export/wp-content && mkdir -p .export/wp-content/uploads && run-p export:wp-content:*",
		"export:db": "mkdir -p .export/sql && npm run wp db -- export .export/sql/local.sql",
		"export": "run-p export:*",
		"import:wp-content:themes": "npm run cli cp -- -r .export/wp-content/themes ../../",
		"import:wp-content:uploads": "npm run cli cp -- -r .export/wp-content/uploads ../../",
		"import:wp-content": "run-p import:wp-content:*",
		"import:db": "npm run wp db -- import .export/sql/local.sql",
		"import": "run-p import:*",
		"wp-env": "wp-env",
		"start": "wp-env start && open http://localhost:8888",
		"stop": "npm run export && wp-env stop",
		"destroy": "wp-env destroy && wp-env destroy --config=.wp-env.tests.json",
		"cli": "wp-env run cli --env-cwd=\"wp-content/plugins/snow-monkey-search\"",
		"wp": "npm run cli wp",
		"composer": "wp-env run --env-cwd=\"wp-content/plugins/snow-monkey-search\" cli composer",
		"test:php:start": "wp-env start --config=.wp-env.tests.json",
		"test-composer": "wp-env run --config=.wp-env.tests.json --env-cwd=\"wp-content/plugins/snow-monkey-search\" cli composer",
		"clean:css": "rimraf dist/css",
		"build": "run-p blocks",
		"blocks:build": "rimraf dist/blocks && wp-scripts build --output-path=dist --experimental-modules",
		"blocks": "run-s format:blocks blocks:build",
		"test:lint:js": "wp-scripts lint-js src/blocks",
		"pretest:php:lint": "npm run test:php:start && npm run test-composer install -- --no-interaction",
		"test:php:lint": "wp-env run --config=.wp-env.tests.json --env-cwd=\"wp-content/plugins/snow-monkey-search\" wordpress composer lint",
		"posttest:php:lint": "wp-env stop --config=.wp-env.tests.json",
		"test:lint:php": "npm run test:php:lint",
		"test:lint": "run-s test:lint:js test:lint:php",
		"pretest:php:unit": "npm run test:php:start && npm run test-composer install -- --no-interaction",
		"test:php:unit": "wp-env run --config=.wp-env.tests.json --env-cwd=\"wp-content/plugins/snow-monkey-search\" wordpress -- vendor/bin/phpunit -c .phpunit.xml.dist --verbose",
		"posttest:php:unit": "wp-env stop --config=.wp-env.tests.json",
		"test:unit:php": "npm run test:php:unit",
		"test:unit": "run-s test:unit:php",
		"test": "run-s test:lint test:unit",
		"format:php": "npm run composer format",
		"format:blocks": "wp-scripts format src/blocks",
		"format": "run-p format:*",
		"clean:zip": "rimraf snow-monkey-search.zip",
		"zip:pack": "rsync -a --exclude='/vendor' --exclude='/node_modules' --exclude='.*' --exclude='*.config.js' --exclude='*.xml.dist' --exclude='/tests' --exclude='package*.json' . snow-monkey-search && wp-env start && npm run composer install -- --no-dev -d snow-monkey-search",
		"zip:archive": "zip -9 -qmr snow-monkey-search.zip snow-monkey-search",
		"zip": "npm run clean:zip && npm run zip:pack && npm run zip:archive",
		"make-pot": "wp-env start && npm run wp i18n -- make-pot . ./languages/snow-monkey-search.pot -- --exclude=.*,src",
		"make-json": "rimraf languages/*.json && npm run wp i18n -- make-json ./languages/snow-monkey-search-ja.po -- --no-purge",
		"make-php": "npm run cli php -- ./bin/l10n.php"
	}
}
